          "items": "<li class=\"nav-item dropdown\"><a data-app-btn=\"true\" class=\"nav-link link dropdown-toggle\" href=\"jeep-engines.html\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">JEEP ENGINES</a><div class=\"dropdown-menu\"><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"jeep-engines.html\" aria-expanded=\"false\">Jeep 4.6 Stroker Engine</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"jeep-testimonials.html\" aria-expanded=\"false\">Jeep Testimonials</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"jeep-build-gallery.html\" aria-expanded=\"false\">Jeep Build Gallery</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"jeep-technical-instructions.html\" aria-expanded=\"false\">Jeep Technical Instructions</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"jeep-customer-photos.html\" aria-expanded=\"false\">Jeep Customer Photos</a></div></li><li class=\"nav-item dropdown\"><a data-app-btn=\"true\" class=\"nav-link link dropdown-toggle\" data-toggle=\"dropdown-submenu\" href=\"lsx-crate-engines.html\" aria-expanded=\"false\">CHEVY ENGINES</a><div class=\"dropdown-menu\"><div class=\"dropdown\"><a data-app-btn=\"true\" class=\"dropdown-item dropdown-toggle\" href=\"lsx-crate-engines.html\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">LSx Crate Engines</a><div class=\"dropdown-menu dropdown-submenu\"><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"lsx-crate-engines.html\" aria-expanded=\"false\">About Our LSx Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"lsx-short-blocks.html\" aria-expanded=\"false\">LSx Short Blocks</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"lsx-complete-engines.html\" aria-expanded=\"false\">LSx Complete Engines</a></div></div><a data-app-btn=\"true\" class=\"dropdown-item text-primary\" href=\"cnc_cylinder_heads.html\" aria-expanded=\"false\">LS CNC Cylinder Heads&nbsp;</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"lt1-lt4-engines.html\">LT1/LT4 Engines 2014-UP Direct Injection</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"lt1-performance-engines.html\">LT1 Performance Engines 1993-1997</a></div></li><li class=\"nav-item dropdown\"><a data-app-btn=\"true\" class=\"nav-link link dropdown-toggle\" href=\"muscle-car-engines.html\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">MUSCLE&nbsp; ENGINES</a><div class=\"dropdown-menu\"><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"muscle-car-engines.html\" aria-expanded=\"false\">About Our Muscle Car Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"chevy-muscle-car-engines.html\" aria-expanded=\"false\">Chevy Muscle Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"chrysler-muscle-car-engines.html\" aria-expanded=\"false\">Chrysler Muscle Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"ford-muscle-car-engines.html\" aria-expanded=\"false\">Ford Muscle Engines</a></div></li><li class=\"nav-item dropdown\"><a data-app-btn=\"true\" class=\"nav-link link dropdown-toggle\" href=\"race-car-engines.html\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">RACE ENGINES</a><div class=\"dropdown-menu\"><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"race-car-engines.html\" aria-expanded=\"false\">About Our Race Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"road-race-engines.html\" aria-expanded=\"false\">Road Race Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"drag-race-engines.html\" aria-expanded=\"false\">Drag Race Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"formula-drift-race-engines.html\" aria-expanded=\"false\">Formula Drift Race Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"circle-track-race-engines.html\" aria-expanded=\"false\">Circle Track Race Engines</a><a data-app-btn=\"true\" class=\"dropdown-item\" href=\"off-road-race-engines.html\" aria-expanded=\"f