          "_anchor": "content6-ii",
          "_params": {
            "paddingTop": "2",
            "paddingBottom": "2",
            "bgColor": "#fff"
          },
          "text1": "<p><b>RETURNS</b></p><p><b><br></b></p><ul><li>All engine parts may be returned within 30 days of purchase and must be unused. Customers will be required to pay for the return shipping and must obtain an RMA number from us before returning the product.</li></ul><p><br></p><ul><li>All engine sales are final and cannot be returned.</li></ul><p><br></p>",
          "text2": "<p><b>REFUNDS</b></p><p><b><br></b></p><ul><li>All engine sales are final. Parts may be returned within 30 days of purchase and must be unused.</li></ul>",
          "_sourceTheme": "mobirise3"
        },
