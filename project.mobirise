          "title": "<span style=\"font-weight: normal;\">383ci 440hp LT1 Long Block Engine</span>",
          "meta": "<i>LAMYNES.PL</i>",
          "_tags": [
            "Theme"
          ],
          "_name": "header3",
          "_anchor": "header3-1hx",
          "_sourceTheme": "mobirise3"
        },
        {
          "_inherit": "msg-box5",
          "_params": {
            "showTitle": true,
            "showText": true,
            "showButtons": true,
            "inverse": true,
            "imageSize": 50,
            "paddingTop": "1",
            "paddingBottom": "0",
            "bgImageRadio": false,
            "bgImage": "@PROJECT_PATH@/assets/images/golen-logo-sm.png",
            "parallax": true,
            "bgColorRadio": true,
            "bgColor": "#ffffff",
            "bgVideoRadio": false,
            "bgVideo": {
              "url": "https://www.youtube.com/watch?v=uNCr7NdOJgw"
