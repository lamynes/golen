          "title": "<span style=\"font-weight: normal;\">CHEVY 427ci LS7 COMPETITION SHORT BLOCK&nbsp;</span>",
          "meta": "<i>LAMYNES.PL</i>",
          "_tags": [
            "Theme"
          ],
          "_name": "header3",
          "_anchor": "header3-zu",
          "_sourceTheme": "mobirise3"
        },
        {
          "_inherit": "msg-box5",
          "_params": {
            "showTitle": true,
            "showText": true,
            "showButtons": true,
            "inverse": true,
            "imageSize": 50,
            "paddingTop": "1",
            "paddingBottom": "0",
            "bgImageRadio": false,
            "bgImage": "@PROJECT_PATH@/assets/images/golen-logo-sm.png",
