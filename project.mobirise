          "text1": "<strong>Address</strong><br><a href=\"https://goo.gl/maps/q9Fs3eGSvpP2\" class=\"text-warning\">Golen Engine Service</a><br>17 Dracut Rd<br>Hudson, NH 03051&nbsp;<br>",
          "text2": "<strong>Contacts</strong><br>Phone: <a href=\"tel:1-800-591-9171\" class=\"text-warning\">1-800-591-9171</a> ext 2.<br>Local: <a href=\"tel:1-603-886-3800\" class=\"text-warning\">1-603-886-3800</a>",
          "text3": "<strong>Links</strong><br><a href=\"https://golenengineservice.com/shipping/\" class=\"text-warning text-primary\" target=\"_blank\">Shipping</a><br><a href=\"https://golenengineservice.com/warranty/\" class=\"text-warning text-primary\" target=\"_blank\">Warranty</a><br><a href=\"https://golenengineservice.com/shop-tour/\" class=\"text-warning text-primary\" target=\"_blank\">360° Shop Tour</a>",
