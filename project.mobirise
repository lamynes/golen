          },
          "text": "<b>360</b>",
          "_tags": [
            "Theme"
          ],
          "_name": "content1",
          "_anchor": "content1-ld",
          "_customHTML": "<section class=\"mbr-section article mbr-section__container\" id=\"content1-ld\" data-rv-view=\"647\" style=\"background-color: rgb(255, 255, 255); padding-top: 0px; padding-bottom: 0px;\">\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-xs-12 lead\">\n                <iframe height=\"600px\" width=\"100%\" src=\"https://momento360.com/e/u/97e24afa3c6f45b4a54b755dc96bfc42?utm_campaign=embed&amp;utm_source=other&amp;utm_medium=other\"></iframe>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_customCSS": "P {\n  font-size: 17px;\n  text-align: left;\n  color: #000000;\n}\nUL {\n  font-size: 17px;\n  color: #000000;\n}\nDIV {\n  text-align: center;\n}\nB {\n  font-size: 30px;\n  color: #000000;\n}\n",
