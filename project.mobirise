    "dyno-tuning-service.html": {
      "settings": {
        "meta_descr": "Here is the Golen Engine Service 12,000 Square Foot facility located in Hudson, NH. All operations from machine work to dyno testing are done in house to ensure high quality.",
        "title": "Dyno Tuning Service",
        "order": "101"
      },
      "components": [
        {
          "_styles": {
            ".hide-buttons .nav-btn": {
              "display": "none !important"
            },
            ".navbar-caption": {
              "color": "#ffffff",
              "font-family": "'Oswald', sans-serif",
              "googleLink": "https://fonts.googleapis.com/css?family=Oswald:400,300,700",
              "font-size": "18px"
            },
            ".navbar-toggler": {
              "color": "#ffffff"
            },
            ".close-icon::before, .close-icon::after": {
              "background-color": "#ffffff"
            },
