              "font-size": "46px"
            }
          },
          "_params": {
            "showMeta": false,
            "paddingTop": "2",
            "paddingBottom": "3",
            "bgColor": "#ffffff"
          },
          "title": "<span style=\"font-size: 36px; font-weight: normal;\">BLOCK SPECIFICATIONS</span>",
          "meta": "ZZ",
          "_tags": [
            "Theme"
          ],
          "_name": "header3",
          "_anchor": "header3-1gg",
          "_sourceTheme": "mobirise3"
        },
        {
          "_params": {
            "paddingTop": 1,
            "paddingBottom": 1,
            "bgColor": "#fff"
          },
          "text1": "<p><b>Block: </b></p><ul><li>New GM LT1/LT4 Aluminum Block Honed with Torque Plates\n</li><li>Bore Size 4.070\"\n</li><li>Zero Decked\n</li><li>Line Honed with ARP Main Studs\n</li><li>Blueprinted Oil Clearances\n</li><li>All New GM Block Plugs Installed\n</li><li>New Durabond Cam Bearings Installed</li></ul><p><br></p><p><b>Pistons: </b></p><ul><li>Wiseco 2618 Forged Pistons with Armor Glide skirt coating</li></ul><p><br></p><p><b>Bearings: </b></p><ul><li>Clevite H-Series Main and Rod Bearings</li></ul><p><br></p><p><b>Lifters:</b> </p><ul><li>GM LS7 Lifters</li></ul><p><br></p><p><b>Gaskets: </b></p><ul><li>GM MLS Head Gaskets</li></ul>",
          "text2": "<p><b>Crank: </b></p><ul><li>Callies Magnum Series 4340 Forged Steel\n</li><li>Stroke 4.000”\n</li><li>Wet or Dry Sump Oiling\n</li><li>Internally Balanced Front and Rear</li></ul><p><br></p><p><b>Rods: </b></p><ul><li>Callies Ultra 4340 Forged Steel H-Beam\n</li><li>6.125” Length\n</li><li>ARP 2000 Rod Bolts</li></ul><p><br></p><p><b>Rings: </b></p><ul><li>Wiseco GFX Stainless Steel</li></ul><p><br></p><p><b>Camshaft: </b></p><ul><li>Comp Cams Billet Hyd Roller Camshaft, Custom Grind</li></ul><p><br></p><p><b>Timing Sets: </b></p><ul><li>GM Roller Timing Set</li></ul><p><br></p><p><b>Oil Delivery: </b></p><ul><li>GM Oil Pump, either wet or dry sump</li></ul><p><br></p><p><br></p>",
          "_tags": [
            "Theme"
          ],
          "_name": "content6",
          "_styles": {
            "P": {
              "font-size": "22px",
              "text-align": "left"
            },
            "UL": {
              "font-size": "20px"
            }
          },
          "_anchor": "content6-1gh",
          "_sourceTheme": "mobirise3"
        },
        {
          "_styles": {
            ".mbr-section-title, .mbr-section-subtitle": {
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "font-size": "20px"
            },
            ".mbr-section-title DIV": {
              "font-size": "36px"
