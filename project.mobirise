        },
        {
          "_params": {
            "paddingTop": "1",
            "paddingBottom": 1,
            "bgColor": "#fff"
          },
          "text": "<b>Engine Assembly</b>",
          "_tags": [
            "Theme"
          ],
          "_name": "content1",
          "_styles": {
            "P": {
              "text-align": "center",
              "font-size": "25px",
              "font-family": "'Oswald', sans-serif",
              "googleLink": "https://fonts.googleapis.com/css?family=Oswald:400,300,700"
            },
            "DIV": {
              "text-align": "center",
              "font-size": "30px"
            },
            "B": {
              "font-size": "36px"
            }
          },
          "_anchor": "content1-lf",
          "_sourceTheme": "mobirise3"
        },
        {
          "_params": {
            "paddingTop": "1",
            "paddingBottom": "2",
            "bgColor": "#ffffff"
          },
          "text": "<p>A clean and organized assembly room is crucial to the success of any engine build. Here at Golen Engine we take care when assembling all engines with proper parts cleaning and assembly practices.</p>",
          "_tags": [
            "Theme"
          ],
          "_name": "content1",
          "_styles": {
            "P": {
              "font-size": "20px",
              "text-align": "center",
              "color": "#000000"
            },
            "UL": {
              "font-size": "20px",
              "color": "#000000"
            }
          },
          "_anchor": "content1-l9",
          "_sourceTheme": "mobirise3"
        },
        {
          "_params": {
            "paddingTop": "0",
            "paddingBottom": "0",
            "bgColor": "#ffffff"
          },
          "text": "<font color=\"#000000\"><span style=\"font-size: 30px;\"><b>360</b></span></font>",
          "_tags": [
            "Theme"
          ],
          "_name": "content1",
          "_anchor": "content1-lb",
          "_customHTML": "<section class=\"mbr-section article mbr-section__container\" id=\"content1-lb\" data-rv-view=\"659\" style=\"background-color: rgb(255, 255, 255); padding-top: 0px; padding-bottom: 0px;\">\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-xs-12 lead\">\n                ​<iframe height=\"600px\" width=\"100%\" src=\"https://momento360.com/e/u/30ed48d778044e82b9fa763ce3cdf594?utm_campaign=embed&amp;utm_source=other&amp;utm_medium=other\"></iframe>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_customCSS": "P {\n  font-size: 17px;\n  text-align: left;\n  color: #000000;\n}\nUL {\n  font-size: 17px;\n  color: #000000;\n}\nDIV {\n  text-align: center;\n}\nB {\n  font-size: 30px;\n  color: #000000;\n}\n",
