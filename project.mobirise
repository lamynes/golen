            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-msg-box4",
              "link": "",
              "size": 250
            }
          },
          "title": "<div><span style=\"font-weight: normal;\">Base Price $9,899</span></div>",
          "text": "<p>The RHS 427ci competition short block uses a new RHS block\nwith 4.125\" bore and a 4.000” Stroke to produce the 427CI.</p><p>This RHS short block can handle big boost and will make big HP!!<br></p>",
          "_tags": [
            "Theme"
          ],
          "buttons": "<a data-app-btn=\"true\" class=\"btn btn-warning\" href=\"contact-us.html\" data-toolbar=\"-mbrBtnMove\">Get Started Today</a> <a data-app-btn=\"true\" class=\"btn btn-warning\" href=\"https://golenengineservice.com/wp-content/uploads/2017/07/427-RHS-Boosted-SB-Web.pdf\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\">Download Spec Sheet</a>",
          "_name": "msg-box4",
          "_styles": {
            "H3": {
              "font-size": "30px",
              "text-align": "center"
            },
            "P": {
