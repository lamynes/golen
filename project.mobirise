              "width": 128,
              "active": true,
              "link": "",
              "alt": "Golen Engine Service",
              "title": "Golen Engine Service"
            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-contacts1",
              "link": "",
