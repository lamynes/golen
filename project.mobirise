          "media": {
            "image": {
              "width": 1400,
              "src": "@PROJECT_PATH@/assets/images/lt1-lt4-short-block.png",
              "link": "",
              "alt": "416ci LT1/LT4 Short Block Engine",
              "title": "416ci LT1/LT4 Short Block Engine",
              "active": true
            },
            "video": {
              "src": "https://www.youtube.com/embed/Tq7p44IA-1U",
              "aspectratio": "16:9",
              "autoplay": false,
              "loop": false
            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-msg-box4",
              "link": "",
              "size": 250
            }
          },
          "title": "<div><span style=\"font-weight: normal;\">Base Price $7,199</span></div>",
          "text": "<p>The LT1/LT4 416ci competition short block uses a new GM LT1/LT4 block with 4.070\" bore to produce the 416CI. &nbsp;This short block provides a strong foundation for NA engines making up to 750hp and can be customized to meet your needs.<br></p>",
          "_tags": [
            "Theme"
          ],
          "buttons": "<a data-app-btn=\"true\" class=\"btn btn-warning\" href=\"contact-us.html\" data-toolbar=\"-mbrBtnMove\">Get Started Today</a> ",
          "_name": "msg-box4",
          "_styles": {
            "H3": {
              "font-size": "30px",
              "text-align": "center"
            },
            "P": {
              "font-size": "20px",
              "color": "#232323",
              "text-align": "left"
            },
            "DIV": {
              "text-align": "center",
              "color": "#e68c07",
              "font-size": "48px",
