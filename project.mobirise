          "title": "<p><span style=\"font-weight: normal;\">Jeep 4.6L 270 HP Carb Turnkey Engine</span></p>",
          "meta": "<i>LAMYNES.PL</i>",
          "_tags": [
            "Theme"
          ],
          "_name": "header3",
          "_anchor": "header3-1an",
          "_sourceTheme": "mobirise3"
        },
        {
          "_inherit": "msg-box5",
          "_params": {
            "showTitle": true,
            "showText": true,
            "showButtons": true,
            "inverse": true,
            "imageSize": 50,
            "paddingTop": "1",
            "paddingBottom": "0",
            "bgImageRadio": false,
            "bgImage": "@PROJECT_PATH@/assets/images/golen-logo-sm.png",
            "parallax": true,
            "bgColorRadio": true,
            "bgColor": "#ffffff",
            "bgVideoRadio": false,
            "bgVideo": {
              "url": "https://www.youtube.com/watch?v=uNCr7NdOJgw"
            },
            "overlay": false,
            "overlayColor": "#fff",
            "overlayOpacity": 0.5
