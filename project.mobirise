            "showText": true,
            "showButtons": true,
            "inverse": false,
            "imageSize": "56",
            "paddingTop": "2",
            "paddingBottom": "2",
            "bgImageRadio": false,
            "bgImage": "@PROJECT_PATH@/assets/images/enginewf.jpg",
            "parallax": true,
            "bgColorRadio": true,
            "bgColor": "#efefef",
